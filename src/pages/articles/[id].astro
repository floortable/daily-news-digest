---
import Base from '../../layouts/Base.astro'; import ArticleDetailSections from '../../components/ArticleDetailSections.astro'; import AttentionAnalysis from '../../components/AttentionAnalysis.astro'; import MediaPlayer from '../../components/MediaPlayer.astro'; import MediaTrendAnalysis from '../../components/MediaTrendAnalysis.astro'; import { getAllArticles, getArticle } from '../../lib/data'; import { formatFollowUpLabel } from '../../lib/follow-up'; import { isMediaPublished } from '../../lib/media'; import type { Article } from '../../lib/schema';
export function getStaticPaths() { return getAllArticles().map((article) => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props; const base = import.meta.env.BASE_URL; const related = article.relatedArticleIds.map(getArticle).filter((item): item is Article => Boolean(item)); const followUpLabel = formatFollowUpLabel(article);
---
<Base title={`${article.title} | Daily News Digest`} description={article.summary.join('')}><article class="article-detail">{followUpLabel && <p class="follow-up-label">{followUpLabel}</p>}<p class="meta">{article.sourceName} · {article.informationType}</p><h1>{article.title}</h1><div class="tags">{article.categories.map((c) => <span>{c}</span>)}</div>{article.top5Rank !== null && isMediaPublished(article.editionDate) && <MediaPlayer date={article.editionDate} />}<section aria-label="概要"><h2>概要</h2>{article.summary.map((s) => <p>{s}</p>)}</section><aside><strong>編集コメント</strong><p>{article.comment}</p></aside><ArticleDetailSections article={article} /><MediaTrendAnalysis article={article} /><AttentionAnalysis article={article} /><a class="source-link" href={article.sourceUrl} target="_blank" rel="noopener noreferrer">原文を開く ↗</a>{related.length > 0 && <section><h2>関連する過去記事</h2><ul>{related.map((item) => <li><a href={`${base}articles/${item.id}/`}>{item.title}</a></li>)}</ul></section>}</article></Base>
