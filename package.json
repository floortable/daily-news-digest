    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:free-tier": "tsx scripts/check-free-tier.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:encrypted": "tsx scripts/check-encrypted.ts",
    "check:public-safety": "tsx scripts/check-public-safety.ts",
